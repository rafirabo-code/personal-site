{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "personal-site",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    // Only /mcp runs the Worker; every other path is served straight from static assets.
    "run_worker_first": ["/mcp", "/mcp/"]
  },
  // 60 MCP requests per minute per IP.
  "ratelimits": [
    { "name": "RATE_LIMITER", "namespace_id": "1001", "simple": { "limit": 60, "period": 60 } }
  ],
  // Serve the site on the custom domain (Cloudflare creates the DNS record and certificate).
  "routes": [{ "pattern": "rafirabo.com", "custom_domain": true }],
  "observability": { "enabled": true }
}
